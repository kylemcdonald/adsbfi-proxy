ADSBFI_DB_DIR=/var/lib/adsbfi-proxy
ADSBFI_CACHE_DIR=/var/cache/adsbfi-proxy/heatmaps
ADSBFI_MODE=live
ADSBFI_POLL_SECONDS=60
ADSBFI_REQUEST_SECONDS=10
ADSBFI_MIN_FREE_GB=5
ADSBFI_BASE_URL=https://globe.adsb.fi/globe_history
# Optional second readsb globe_history instance, tried on 403/404 or errors.
# ADSBFI_FALLBACK_URL=
# Optional read-only bulk copy of the same YYYY/MM/DD/heatmap layout.
# ADSBFI_ARCHIVE_DIR=/path/to/globe_history
# For a new database, optionally choose its first slot:
# ADSBFI_START=2026-01-01
# Mirror mode retains all files and audits history every six hours.
# ADSBFI_MODE=mirror
# ADSBFI_MIRROR_START=2020-05-21T21:00:00Z
